# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
/.angular/cache

# dependencies
/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Local environment / secrets
.env
.env.*
!.env.example

# flare reporter config — generated by scripts/gen-flare-env.mjs at build
# time from FLARE_URL/FLARE_KEY/COMMIT_REF; never commit the real key
/src/app/flare/flare-config.ts

# Netlify
.netlify

# System Files
.DS_Store
Thumbs.db
